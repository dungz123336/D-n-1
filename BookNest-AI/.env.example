# ============================================================
# BookNest Concierge — Environment
# Copy to .env and fill values. Switch AI with AI_PROVIDER only.
# ============================================================

APP_NAME=BookNest Concierge
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_PREFIX=/api/v1
# `*` cho phép nhúng widget vào bất kỳ website nào (dev/demo).
# Production: thay bằng danh sách origin cụ thể, ví dụ https://shop-cua-ban.com
CORS_ORIGINS=*
LOG_LEVEL=INFO

# --- Multi-provider switch (no code change needed) ---
# openai | gemini | claude | grok | deepseek | qwen | openrouter | ollama | mock
# `mock` = chạy offline KHÔNG cần API key (demo cho cả team).
# Khi có key thật, đổi provider và điền key tương ứng bên dưới.
AI_PROVIDER=mock
AI_MODEL=
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2048
AI_TIMEOUT_SECONDS=90

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

GROK_API_KEY=
XAI_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.5

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# SQLite (dev) or PostgreSQL (prod)
# Used by the `backend` bot (backend.main:app) — the primary one.
# DATABASE_URL=sqlite+aiosqlite:///./booknest_ai.db
# DATABASE_URL=postgresql+asyncpg://booknest:booknest@localhost:5432/booknest_ai
DATABASE_URL=sqlite+aiosqlite:///./booknest_ai.db

# Used by the `app` bot (app.main:app). It has its own ORM models, so it needs
# its own schema — do not point this at the same database as DATABASE_URL.
APP_DATABASE_URL=sqlite+aiosqlite:///./booknest_app.db

REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=false

SECRET_KEY=change-me-secret
JWT_SECRET=change-me-jwt
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_API_KEY=dev-admin-api-key
RATE_LIMIT=120/minute

UPLOAD_DIR=./uploads
LOG_DIR=./logs
LOG_AI_PROMPTS=true
